# Porta HTTP/WebSocket
PORT=2567
# Obrigatório em produção: segredo para assinar os tokens de login (use algo longo e aleatório)
JWT_SECRET=troque-isto
# Caminho do banco SQLite (em produção aponte para um volume persistente)
DB_PATH=./data/gather-lite.sqlite
NODE_ENV=production

# Opcional: áudio e vídeo por proximidade (LiveKit Cloud ou self-hosted)
LIVEKIT_URL=wss://seu-projeto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Login com Google (OAuth 2.0). No Google Cloud, redirect URI = https://SEU_HOST/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL pública do app (usada para montar o redirect atrás de proxy/ALB), ex.: https://office.suaempresa.com
PUBLIC_URL=
# AUTH_MODE=google desativa cadastro e login por senha (só Google)
AUTH_MODE=
# ALLOW_GUESTS=0 desativa a entrada como visitante (inclusive por convite)
ALLOW_GUESTS=1
# Restringe o Google a domínios de e-mail (separados por vírgula), ex.: amorsaude.com
GOOGLE_ALLOWED_DOMAINS=
# Opcional: mais de uma instância (presença e matchmaking compartilhados)
REDIS_URL=
# Opcional: pasta dos uploads (padrão: ao lado do banco)
UPLOAD_DIR=
