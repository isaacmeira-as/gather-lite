# Porta HTTP/WebSocket
PORT=2567
# Obrigatório em produção: segredo para assinar os tokens de login (use algo longo e aleatório)
JWT_SECRET=troque-isto
# Caminho do banco SQLite (em produção aponte para um volume persistente)
DB_PATH=./data/gather-lite.sqlite
NODE_ENV=production

# Opcional: áudio e vídeo por proximidade (LiveKit Cloud ou self-hosted)
LIVEKIT_URL=wss://seu-projeto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Opcional: login com Google (OAuth 2.0, redirect = https://SEU_HOST/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: mais de uma instância (presença e matchmaking compartilhados)
REDIS_URL=
# Opcional: pasta dos uploads (padrão: ao lado do banco)
UPLOAD_DIR=
