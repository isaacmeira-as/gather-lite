{
  "name": "gather-lite",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "tsx tests/e2e/run.ts",
    "db:reset": "rm -f data/gather-lite.sqlite data/gather-lite.sqlite-wal data/gather-lite.sqlite-shm"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@colyseus/monitor": "^0.18.7",
    "@colyseus/schema": "^5.0.52",
    "@colyseus/sdk": "^0.18.10",
    "colyseus": "^0.18.12",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  },
  "private": true,
  "type": "module"
}